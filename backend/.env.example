APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# RAG — update these once your external services are ready.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_DOCUMENTS_INDEX=rag_documents
ELASTICSEARCH_CHUNKS_INDEX=rag_chunks

PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_HOST=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co
# Change the embedding model and its dimension together, then create a matching Pinecone index.
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_EMBEDDING_DIMENSIONS=384
HUGGINGFACE_EMBEDDING_BATCH_SIZE=32
# Change this to an instruct model your Hugging Face account can access.
HUGGINGFACE_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_LLM_MAX_TOKENS=800

RAG_DOCUMENTS_PATH=../documents
RAG_CHUNK_SIZE=4000
RAG_CHUNK_OVERLAP=600
RAG_TOP_K_LEXICAL=20
RAG_TOP_K_VECTOR=20
RAG_TOP_K_FINAL=8
RAG_RRF_K=60
